<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>OpenCodeTelegramBridge</AssemblyName>
    <RootNamespace>OpenCodeTelegramBridge</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Telegram.Bot" Version="22.10.3.1" />
  </ItemGroup>

  <!-- data/ holds runtime state (config.json with secrets, session cache, downloaded xray binary) —
       never bundle it into build/publish output; each deployment gets its own data/ created at first run. -->
  <ItemGroup>
    <Content Remove="data/**" />
    <None Remove="data/**" />
    <Compile Remove="tests/**" />
    <Content Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

</Project>
